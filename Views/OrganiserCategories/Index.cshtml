@model CategoriesViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Categories · " + ev.Name;
}
<section class="container py-4">
    <a asp-controller="OrganiserEvents" asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> Manage events</a>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mt-2 mb-4">
        <div>
            <h1 class="rd-title mb-1">Categories</h1>
            <p class="text-muted mb-0">@ev.Name &middot; @Display.Date(ev.EventDate) &middot; @ev.Location</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-rd btn-sm" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.EventId"><i class="bi bi-people-fill"></i> Enrolments</a>
            <a class="btn btn-outline-rd btn-sm" asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId"><i class="bi bi-eye-fill"></i> Public page</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="card rd-panel">
                <div class="card-body p-4">
                    <h2 class="rd-title h4 mb-3">Add a category</h2>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">Quick fill</div>
                        <div class="d-flex flex-wrap gap-1" id="category-presets">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="5km" data-preset-km="5">5 km</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="10km" data-preset-km="10">10 km</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="21km Half Marathon" data-preset-km="21.1">21 km</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="42km Marathon" data-preset-km="42.2">42 km</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="Under 20" data-preset-km="@ev.DistanceKm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">Under 20</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="Senior" data-preset-km="@ev.DistanceKm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">Senior</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-preset-name="Veteran 50+" data-preset-km="@ev.DistanceKm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">50+</button>
                        </div>
                    </div>

                    <form asp-action="Add" asp-route-eventId="@ev.EventId" method="post" id="add-category-form">
                        <div class="mb-3">
                            <label class="form-label" for="add-name">Name</label>
                            <input class="form-control" id="add-name" name="Name" maxlength="100" required placeholder="e.g. 10km, Under 20, Senior" />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label" for="add-km">Distance (km)</label>
                                <input class="form-control" id="add-km" name="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="add-max">Max participants</label>
                                <input class="form-control" id="add-max" name="MaxParticipants" type="number" min="1" max="1000000" value="100" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="add-fee">Entry fee (R)</label>
                                <input class="form-control" id="add-fee" name="EntryFee" type="number" step="0.01" min="0" max="999999.99" value="0" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-rd w-100 mt-4"><i class="bi bi-plus-lg"></i> Add category</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            @if (ev.Categories.Count == 0)
            {
                <div class="rd-empty">
                    <i class="bi bi-tags"></i>
                    <h2 class="h5">No categories yet</h2>
                    <p class="text-muted mb-0">Participants need at least one category to enrol. Use the form to add one.</p>
                </div>
            }
            else
            {
                <div class="card rd-panel">
                    <div class="table-responsive">
                        <table class="table rd-table align-middle mb-0">
                            <thead><tr><th>Category</th><th>Distance</th><th>Entry fee</th><th>Places</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in ev.Categories)
                                {
                                    var fill = c.MaxParticipants == 0 ? 0 : Math.Min(100, (int)Math.Round(c.EnrolledCount * 100.0 / c.MaxParticipants));
                                    <tr>
                                        <td><strong>@c.Name</strong></td>
                                        <td>@Display.Km(c.DistanceKm)</td>
                                        <td>@Display.Money(c.EntryFee)</td>
                                        <td style="min-width: 150px">
                                            <div class="small mb-1">@c.EnrolledCount / @c.MaxParticipants</div>
                                            <div class="rd-bar"><div class="rd-bar-fill" style="width: @(fill)%"></div></div>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <button type="button" class="btn btn-outline-rd btn-sm js-edit-category"
                                                    data-edit-url="@Url.Action("Edit", "OrganiserCategories", new { eventId = ev.EventId, categoryId = c.CategoryId })"
                                                    data-name="@c.Name"
                                                    data-km="@c.DistanceKm.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-max="@c.MaxParticipants"
                                                    data-fee="@c.EntryFee.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form asp-action="Delete" asp-route-eventId="@ev.EventId" asp-route-categoryId="@c.CategoryId" method="post" class="d-inline" data-confirm="Delete the &quot;@(c.Name)&quot; category? Anyone enrolled in it will lose their enrolment.">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash3-fill"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="edit-category-form" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h2 class="modal-title h5 rd-title" id="editCategoryTitle">Edit category</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="edit-name">Name</label>
                    <input class="form-control" id="edit-name" name="Name" maxlength="100" required />
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="edit-km">Distance (km)</label>
                        <input class="form-control" id="edit-km" name="DistanceKm" type="number" step="0.01" min="0.01" max="999.99" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="edit-max">Max participants</label>
                        <input class="form-control" id="edit-max" name="MaxParticipants" type="number" min="1" max="1000000" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="edit-fee">Entry fee (R)</label>
                        <input class="form-control" id="edit-fee" name="EntryFee" type="number" step="0.01" min="0" max="999999.99" required />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-rd">Save changes</button>
            </div>
        </form>
    </div>
</div>
