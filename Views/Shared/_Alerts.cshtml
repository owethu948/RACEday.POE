@* Flash messages are shown as pop-up toasts by site.js. The data attributes carry the text. *@
@if (TempData["Success"] is string success)
{
    <div class="d-none" data-flash="success" data-message="@success"></div>
}
@if (TempData["Error"] is string error)
{
    <div class="d-none" data-flash="error" data-message="@error"></div>
}
