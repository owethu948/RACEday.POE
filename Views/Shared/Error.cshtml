@model ErrorViewModel
@{
    ViewData["Title"] = Model.Heading;
}
<section class="rd-error">
    <div class="rd-error-code">@Model.StatusCode</div>
    <h2 class="mb-2">@Model.Heading</h2>
    <p class="text-muted mb-4">@Model.Message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-rd btn-lg">Back to RaceDay</a>
</section>
