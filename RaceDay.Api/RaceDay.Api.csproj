<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RaceDay.Api</RootNamespace>
    <!-- Lets `dotnet user-secrets` hold the Azure connection string outside the repository -->
    <UserSecretsId>raceday-api-6f1d2c9e-3b8a-4c57-9a1e-0d7f5b2c4e11</UserSecretsId>
    <!-- XML doc comments feed the Swagger UI descriptions -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;ASP0027</NoWarn>
    <!-- Report known vulnerabilities in direct AND transitive packages during restore/build -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Part 3: image storage. Only the API references this package; the MVC project must never do so. -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <!-- Microsoft.OpenApi comes in transitively via SwaggerGen; do not reference it directly. -->

    <!--
      SECURITY FIX: Microsoft.Data.SqlClient (pulled in by EF Core SqlServer) depends on
      System.Security.Cryptography.Pkcs 9.0.11, which is affected by GHSA-846f-f764-76mx (high)
      and GHSA-2fmv-rv2c-59x7 (moderate). Referencing the patched 10.0.13 directly overrides
      the vulnerable transitive version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
